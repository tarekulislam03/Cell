{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CELL",
  "version": "0.1.0",
  "identifier": "com.cell.terminal",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CHRONO",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}